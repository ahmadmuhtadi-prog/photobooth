<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="28dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="SELAMAT DATANG"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Photobooth"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Pilih jenis acara untuk mulai berfoto"
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <ScrollView
            android:id="@+id/menuScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/eventGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:text="SENTUH UNTUK MULAI"
            android:textColor="#FF14111A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Area rahasia operator: tekan lama pojok kanan atas -->
    <View
        android:id="@+id/settingsHotspot"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|end" />
</FrameLayout>
